{
  "kind": "app",
  "version": "0.3.0",
  "app": {
    "name": "BOSS直聘自动投简历",
    "mode": "workflow",
    "description": "在武汉按关键词搜索职位，点第一个职位打沟通，自动过验证码，粘贴招呼语发出去。"
  },
  "workflow": {
    "environment_variables": [],
    "conversation_variables": [],
    "graph": {
      "nodes": [
        {
          "id": "start",
          "data": {
            "type": "start",
            "title": "开始",
            "variables": [
              {
                "label": "搜索词",
                "required": true,
                "type": "text-input",
                "variable": "关键词"
              },
              {
                "label": "职位名称",
                "required": true,
                "type": "text-input",
                "variable": "职位"
              },
              {
                "label": "招呼语",
                "required": true,
                "type": "text-input",
                "variable": "招呼语"
              }
            ]
          }
        },
        {
          "id": "build",
          "data": {
            "type": "code",
            "title": "搜索地址",
            "code": "const keyword = encodeURIComponent(String(inputs.关键词 || ''));\nreturn { url: 'https://www.zhipin.com/web/geek/job?query=' + keyword + '&city=101200100' };",
            "outputs": {
              "url": {
                "type": "string"
              }
            },
            "variables": [
              {
                "value_selector": [
                  "input",
                  "关键词"
                ],
                "variable": "关键词"
              }
            ]
          }
        },
        {
          "id": "open",
          "data": {
            "type": "goto",
            "title": "打开搜索",
            "url": "{{#build.url#}}"
          }
        },
        {
          "id": "captcha",
          "data": {
            "type": "captcha",
            "title": "过验证码",
            "engine": "auto",
            "retries": "2"
          }
        },
        {
          "id": "find",
          "data": {
            "type": "scroll",
            "title": "滚到职位",
            "direction": "down",
            "until": {
              "xpath": "//li[contains(@class,'job-card-box')][.//a[normalize-space(.)='{{#input.职位#}}']]//ul[contains(@class,'tag-list')]"
            }
          }
        },
        {
          "id": "pick",
          "data": {
            "type": "click",
            "title": "选中职位",
            "locator": {
              "xpath": "//li[contains(@class,'job-card-box')][.//a[normalize-space(.)='{{#input.职位#}}']]//ul[contains(@class,'tag-list')]"
            }
          }
        },
        {
          "id": "talk",
          "data": {
            "type": "click",
            "title": "立即沟通",
            "locator": {
              "xpath": "//a[normalize-space(.)='立即沟通']"
            }
          }
        },
        {
          "id": "dismiss",
          "data": {
            "type": "script",
            "title": "关掉确认弹窗",
            "source": "const ok = Array.from(document.querySelectorAll('button, span, a')).find((node) => (node.innerText || '').trim() === '确定' && node.getBoundingClientRect().width > 0);\nif (ok) ok.click();\nreturn { ok: true };"
          }
        },
        {
          "id": "waitchat",
          "data": {
            "type": "wait",
            "title": "等沟通窗口打开",
            "state": "appear",
            "timeout": "15",
            "locator": {
              "selector": ".chat-input"
            }
          }
        },
        {
          "id": "draft",
          "data": {
            "type": "fill",
            "title": "填写招呼语",
            "entry": "paste",
            "locator": {
              "xpath": "//div[contains(@class,'chat-input')]"
            },
            "text": "{{#input.招呼语#}}"
          }
        },
        {
          "id": "send",
          "data": {
            "type": "click",
            "title": "发送",
            "locator": {
              "xpath": "//button[normalize-space(.)='发送']"
            }
          }
        },
        {
          "id": "check",
          "data": {
            "type": "script",
            "title": "确认发出",
            "source": "const start = Date.now();\nwhile (Date.now() - start < 10000) {\n  const draft = ((document.querySelector('.chat-input') || {}).innerText || '').trim();\n  const thread = ((document.querySelector('.chat-conversation') || {}).innerText || '');\n  if (!draft && thread.includes('简历已在 BOSS 上')) return { ok: true };\n  await new Promise((resolve) => setTimeout(resolve, 250));\n}\nthrow new Error('消息没有发出去');"
          }
        },
        {
          "id": "end",
          "data": {
            "type": "end",
            "title": "结束",
            "outputs": [
              {
                "value_selector": [
                  "input",
                  "职位"
                ],
                "variable": "职位"
              }
            ]
          }
        }
      ],
      "edges": [
        {
          "id": "start-build",
          "source": "start",
          "target": "build"
        },
        {
          "id": "build-open",
          "source": "build",
          "target": "open"
        },
        {
          "id": "open-captcha",
          "source": "open",
          "target": "captcha"
        },
        {
          "id": "captcha-find",
          "source": "captcha",
          "target": "find"
        },
        {
          "id": "find-pick",
          "source": "find",
          "target": "pick"
        },
        {
          "id": "pick-talk",
          "source": "pick",
          "target": "talk"
        },
        {
          "id": "talk-dismiss",
          "source": "talk",
          "target": "dismiss"
        },
        {
          "id": "dismiss-waitchat",
          "source": "dismiss",
          "target": "waitchat"
        },
        {
          "id": "waitchat-draft",
          "source": "waitchat",
          "target": "draft"
        },
        {
          "id": "draft-send",
          "source": "draft",
          "target": "send"
        },
        {
          "id": "send-check",
          "source": "send",
          "target": "check"
        },
        {
          "id": "check-end",
          "source": "check",
          "target": "end"
        }
      ]
    }
  }
}
